# TraceForge environment — copy to `.env.local` and adjust.
# Validated by src/shared/config/env.ts (zod); the app BOOTS with only
# DATABASE_URL + auth vars. Everything else degrades gracefully (plan §9):
# no Redis → polling, no storage creds → local adapter, WORKER_MODE=off.
#
# PRODUCTION (NODE_ENV=production): DATABASE_URL, BETTER_AUTH_URL,
# BETTER_AUTH_SECRET and INVITE_SIGNING_SECRET must be set EXPLICITLY and the
# two secrets must NOT be the values below (they are public in this repo).
# Startup fails fast with a list of violations otherwise. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- boot-critical -----------------------------------------------------------
# Dev: Docker Postgres (docker compose up -d), port 5433. Prod: Neon (required).
DATABASE_URL=postgresql://traceforge:traceforge@localhost:5433/traceforge

# Better Auth (required for sessions; dev defaults exist, REQUIRED in production
# with >= 32 chars, and the public dev default value is rejected there)
BETTER_AUTH_SECRET=change-me-min-32-characters-please
BETTER_AUTH_URL=http://localhost:3000

# --- optional OAuth (absent → email/password only) ---------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- optional services -------------------------------------------------------
# Signed expiring invite links (shared/lib/invites.ts).
# REQUIRED in production (>= 16 chars, public dev default rejected there).
INVITE_SIGNING_SECRET=change-me-invite-secret

# Storage: local (default, public/demo-assets) | r2
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Redis (Upstash REST). Absent → SSE falls back to polling.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# off (default) | mock (examples/mock-worker) | live
WORKER_MODE=off

# Slug of the seeded demo organization (optional)
DEMO_ORG_SLUG=
